# Copy to .env and fill in the values. Never commit .env.

# Database (used by docker-compose.yml and the backend)
POSTGRES_USER=wsr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wsr
POSTGRES_PORT=5432
DATABASE_URL=postgres://wsr:change-me@localhost:5432/wsr

# Jira Cloud (read-only access)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_BOARD_ID=

# Sign-in: argon2 hash of the shared administrator password
APP_ADMIN_PASSWORD_HASH=
# Random string of at least 32 characters used to sign session cookies
SESSION_SECRET=
# Session lifetime in hours (default 8)
SESSION_LIFETIME_HOURS=8
# Number of reverse proxies in front of the app (default 0); needed for correct client IPs in rate limiting
TRUST_PROXY=0

# Optional LLM executive summary (OpenAI-compatible endpoint); leave empty to disable
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
